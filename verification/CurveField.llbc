rch = \"x86_64\", not(curve25519_serial_only)))]\n    {\n        cpufeatures::new!(cpuid_avx2, \"avx2\");\n        let token_avx2: cpuid_avx2::InitToken = cpuid_avx2::init();\n        if token_avx2.get() {\n            return BackendKind::Avx2;\n        }\n    }\n\n    BackendKind::Serial\n}","attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[],"output":{"Deduplicated":9040}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":3,"beg":{"line":53,"col":0},"end":{"line":64,"col":1}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":0,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":3,"beg":{"line":53,"col":29},"end":{"line":53,"col":40}},"generated_from_span":null},"ty":{"Deduplicated":9040}}]},"body":{"span":{"data":{"file_id":3,"beg":{"line":63,"col":4},"end":{"line":64,"col":1}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":3,"beg":{"line":63,"col":4},"end":{"line":63,"col":23}},"generated_from_span":null},"id":14494,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":9040}},{"Aggregate":[{"Adt":[{"id":{"Adt":82},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}},0,null]},[]]}]},"comments_before":[]},{"span":{"data":{"file_id":3,"beg":{"line":64,"col":1},"end":{"line":64,"col":1}},"generated_from_span":null},"id":14495,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":448,"item_meta":{"name":[{"Ident":["curve25519",0]},{"Ident":["backend",0]},{"Ident":["serial",0]},{"Ident":["scalar_mul",0]},{"Ident":["variable_base",0]},{"Ident":["mul",0]}],"span":{"data":{"file_id":85,"beg":{"line":11,"col":0},"end":{"line":48,"col":1}},"generated_from_span":null},"source_text":"pub(crate) fn mul(point: &EdwardsPoint, scalar: &Scalar) -> EdwardsPoint {\n    // Construct a lookup table of [P,2P,3P,4P,5P,6P,7P,8P]\n    let lookup_table = LookupTable::<ProjectiveNielsPoint>::from(point);\n    // Setting s = scalar, compute\n    //\n    //    s = s_0 + s_1*16^1 + ... + s_63*16^63,\n    //\n    // with `-8 ≤ s_i < 8` for `0 ≤ i < 63` and `-8 ≤ s_63 ≤ 8`.\n    // This decomposition requires s < 2^255, which is guaranteed by Scalar invariant #1.\n    let scalar_digits = scalar.as_radix_16();\n    // Compute s*P as\n    //\n    //    s*P = P*(s_0 +   s_1*16^1 +   s_2*16^2 + ... +   s_63*16^63)\n    //    s*P =  P*s_0 + P*s_1*16^1 + P*s_2*16^2 + ... + P*s_63*16^63\n    //    s*P = P*s_0 + 16*(P*s_1 + 16*(P*s_2 + 16*( ... + P*s_63)...))\n    //\n    // We sum right-to-left.\n\n    // Unwrap first loop iteration to save computing 16*identity\n    let mut tmp2;\n    let mut tmp3 = EdwardsPoint::identity();\n    let mut tmp1 = &tmp3 + &lookup_table.select(scalar_digits[63]);\n    // Now tmp1 = s_63*P in P1xP1 coords\n    for i in (0..63).rev() {\n        tmp2 = tmp1.as_projective(); // tmp2 =    (prev) in P2 coords\n        tmp1 = tmp2.double();        // tmp1 =  2*(prev) in P1xP1 coords\n        tmp2 = tmp1.as_projective(); // tmp2 =  2*(prev) in P2 coords\n        tmp1 = tmp2.double();        // tmp1 =  4*(prev) in P1xP1 coords\n        tmp2 = tmp1.as_projective(); // tmp2 =  4*(prev) in P2 coords\n        tmp1 = tmp2.double();        // tmp1 =  8*(prev) in P1xP1 coords\n        tmp2 = tmp1.as_projective(); // tmp2 =  8*(prev) in P2 coords\n        tmp1 = tmp2.double();        // tmp1 = 16*(prev) in P1xP1 coords\n        tmp3 = tmp1.as_extended();   // tmp3 = 16*(prev) in P3 coords\n        tmp1 = &tmp3 + &lookup_table.select(scalar_digits[i]);\n        // Now tmp1 = s_i*P + 16*(prev) in P1xP1 coords\n    }\n    tmp1.as_extended()\n}","attr_info":{"attributes":[{"DocComment":" Perform constant-time, variable-base scalar multiplication."},{"Unknown":{"path":"rustfmt::skip","args":null}}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":11778},{"Deduplicated":11782}],"output":{"Deduplicated":2919}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":449,"item_meta":{"name":[{"Ident":["curve25519",0]},{"Ident":["backend",0]},{"Ident":["serial",0]},{"Ident":["u64",0]},{"Ident":["constants",0]},{"Ident":["ED25519_BASEPOINT_POINT",0]}],"span":{"data":{"file_id":76,"beg":{"line":163,"col":0},"end":{"line":186,"col":2}},"generated_from_span":null},"source_text":"pub const ED25519_BASEPOINT_POINT: EdwardsPoint = EdwardsPoint {\n    X: FieldElement51::from_limbs([\n        1738742601995546,\n        1146398526822698,\n        2070867633025821,\n        562264141797630,\n        587772402128613,\n    ]),\n    Y: FieldElement51::from_limbs([\n        1801439850948184,\n        1351079888211148,\n        450359962737049,\n        900719925474099,\n        1801439850948198,\n    ]),\n    Z: FieldElement51::from_limbs([1, 0, 0, 0, 0]),\n    T: FieldElement51::from_limbs([\n        1841354044333475,\n        16398895984059,\n        755974180946558,\n        900171276175154,\n        1821297809914039,\n    ]),\n};","attr_info":{"attributes":[{"DocComment":" The Ed25519 basepoint, as an `EdwardsPoint`."},{"DocComment":""},{"DocComment":" This is called `_POINT` to distinguish it from"},{"DocComment":" `ED25519_BASEPOINT_TABLE`, which should be used for scalar"},{"DocComment":" multiplication (it's much faster)."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"type