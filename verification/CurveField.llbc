mment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(Point { x: 2, y: 3 } - Point { x: 1, y: 0 },"},{"DocComment":"            Point { x: 1, y: 3 });"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"sub"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Rhs"},{"index":2,"name":"Self_Output"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"sub","attr_info":{"attributes":[{"DocComment":" Performs the `-` operation."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!(12 - 1, 11);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":11755},{"Deduplicated":11756}],"output":{"Deduplicated":11793}},"item":{"id":308,"generics":{"regions":[],"types":[{"Deduplicated":11755},{"Deduplicated":11756},{"Deduplicated":11793}],"const_generics":[],"trait_refs":[{"HashConsedValue":[11840,{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":11755},{"Deduplicated":11756},{"Deduplicated":11793}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[15,0]}}],"vtable":{"id":{"Adt":63},"generics":{"regions":[],"types":[{"Deduplicated":11756},{"Deduplicated":11793}],"const_generics":[],"trait_refs":[]}}},{"def_id":16,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["arith",0]},{"Ident":["MulAssign",0]}],"span":{"data":{"file_id":37,"beg":{"line":901,"col":0},"end":{"line":901,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The multiplication assignment operator `*=`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::MulAssign;"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" struct Frequency { hertz: f64 }"},{"DocComment":""},{"DocComment":" impl MulAssign<f64> for Frequency {"},{"DocComment":"     fn mul_assign(&mut self, rhs: f64) {"},{"DocComment":"         self.hertz *= rhs;"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut frequency = Frequency { hertz: 50.0 };"},{"DocComment":" frequency *= 4.0;"},{"DocComment":" assert_eq!(Frequency { hertz: 200.0 }, frequency);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"mul_assign"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Rhs"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"mul_assign","attr_info":{"attributes":[{"DocComment":" Performs the `*=` operation."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut x: u32 = 12;"},{"DocComment":" x *= 2;"},{"DocComment":" assert_eq!(x, 24);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":11822},{"Deduplicated":11756}],"output":{"Deduplicated":1801}},"item":{"id":309,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":11755},{"Deduplicated":11756}],"const_generics":[],"trait_refs":[{"HashConsedValue":[11841,{"kind":"SelfId","trait_decl_ref":{"regio