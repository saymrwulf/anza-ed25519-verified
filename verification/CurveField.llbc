e_id":8,"beg":{"line":370,"col":4},"end":{"line":370,"col":5}},"generated_from_span":null},"id":4773,"kind":{"StorageDead":27},"comments_before":[]},{"span":{"data":{"file_id":8,"beg":{"line":370,"col":4},"end":{"line":370,"col":5}},"generated_from_span":null},"id":4774,"kind":{"StorageDead":13},"comments_before":[]},{"span":{"data":{"file_id":8,"beg":{"line":370,"col":4},"end":{"line":370,"col":5}},"generated_from_span":null},"id":4775,"kind":{"StorageDead":8},"comments_before":[]},{"span":{"data":{"file_id":8,"beg":{"line":370,"col":4},"end":{"line":370,"col":5}},"generated_from_span":null},"id":4776,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"data":{"file_id":8,"beg":{"line":370,"col":5},"end":{"line":370,"col":5}},"generated_from_span":null},"id":4777,"kind":"Return","comments_before":[]}]},"comments":[[341,["Using the same trick as in ed25519 decoding, we merge the","inversion, the square root, and the square test as follows.","","To compute sqrt(α), we can compute β = α^((p+3)/8).","Then β^2 = ±α, so multiplying β by sqrt(-1) if necessary","gives sqrt(α).","","To compute 1/sqrt(α), we observe that","   1/β = α^(p-1 - (p+3)/8) = α^((7p-11)/8)","                           = α^3 * (α^7)^((p-5)/8).","","We can therefore compute sqrt(u/v) = sqrt(u)/sqrt(v)","by first computing","   r = u^((p+3)/8) v^(p-1-(p+3)/8)","     = u u^((p-5)/8) v^3 (v^7)^((p-5)/8)","     = (uv^3) (uv^7)^((p-5)/8).","","If v is nonzero and u/v is square, then r^2 = ±u/v,","                                    so vr^2 = ±u.","If vr^2 =  u, then sqrt(u/v) = r.","If vr^2 = -u, then sqrt(u/v) = r*sqrt(-1).","","If v is zero, r is also zero."]],[363,["Choose the nonnegative square root.","","NOTE: written as negate-then-conditional-assign rather than","`r.conditional_negate(r_is_negative)`: semantically identical and","still constant-time, but it avoids subtle's `ConditionallyNegatable`","blanket impl (whose `for<'a> &'a T: Neg` bound breaks the Aeneas","verification toolchain; see verification/field/README.md)."]]]}}},{"def_id":56,"item_meta":{"name":[{"Ident":["curve25519",0]},{"Ident":["field",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":3140},"kind":"InherentImplBlock"}}},{"Ident":["invsqrt",0]}],"span":{"data":{"file_id":8,"beg":{"line":384,"col":4},"end":{"line":386,"col":5}},"generated_from_span":null},"source_text":"pub(crate) fn invsqrt(&self) -> (Choice, FieldElement) {\n        FieldElement::sqrt_ratio_i(&FieldElement::ONE, self)\n    }","attr_info":{"attributes":[{"DocComment":" Attempt to compute `sqrt(1/self)` in constant time."},{"DocComment":""},{"DocComment":" Convenience wrapper around `sqrt_ratio_i`."},{"DocComment":""},{"DocComment":" This function always returns the nonnegative square root."},{"DocComment":""},{"DocComment":" # Return"},{"DocComment":""},{"DocComment":" - `(Choice(1), +sqrt(1/self))  ` if `self` is a nonzero square;"},{"DocComment":" - `(Choice(0), zero)           ` if `self` is zero;"},{"DocComment":" - `(Choice(0), +sqrt(i/self))  ` if `self` is a nonzero nonsquare;"},{"DocComment":""}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":11760}],"output":{"Deduplicated":7039}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":8,"beg":{"line":384,"col":4},"end":{"line":386,"col":5}},"generated_from_span":null},"bound_body_regions":12,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":8,"beg":{"line":384,"col":36},"end":{"line":384,"col":58}},"generated_from_span":null},"ty":{"Deduplica