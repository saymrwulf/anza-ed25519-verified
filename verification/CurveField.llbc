},"generated_from_span":null},"id":4471,"kind":{"StorageDead":16},"comments_before":[]},{"span":{"data":{"file_id":8,"beg":{"line":193,"col":4},"end":{"line":193,"col":5}},"generated_from_span":null},"id":4472,"kind":{"StorageDead":12},"comments_before":[]},{"span":{"data":{"file_id":8,"beg":{"line":193,"col":4},"end":{"line":193,"col":5}},"generated_from_span":null},"id":4473,"kind":{"StorageDead":8},"comments_before":[]},{"span":{"data":{"file_id":8,"beg":{"line":193,"col":4},"end":{"line":193,"col":5}},"generated_from_span":null},"id":4474,"kind":{"StorageDead":4},"comments_before":[]},{"span":{"data":{"file_id":8,"beg":{"line":193,"col":4},"end":{"line":193,"col":5}},"generated_from_span":null},"id":4475,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":8,"beg":{"line":193,"col":5},"end":{"line":193,"col":5}},"generated_from_span":null},"id":4476,"kind":"Return","comments_before":[]}]},"comments":[[171,["Instead of managing which temporary variables are used","for what, we define as many as we need and leave stack","allocation to the compiler","","Each temporary variable t_i is of the form (self)^e_i.","Squaring t_i corresponds to multiplying e_i by 2,","so the pow2k function shifts e_i left by k places.","Multiplying t_i and t_j corresponds to adding e_i + e_j.","","Temporary t_i                      Nonzero bits of e_i",""]]]}}},{"def_id":52,"item_meta":{"name":[{"Ident":["curve25519",0]},{"Ident":["field",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":3140},"kind":"InherentImplBlock"}}},{"Ident":["internal_invert_batch",0]}],"span":{"data":{"file_id":8,"beg":{"line":216,"col":4},"end":{"line":270,"col":5}},"generated_from_span":null},"source_text":"fn internal_invert_batch(inputs: &mut [FieldElement], scratch: &mut [FieldElement]) {\n        // Montgomery’s Trick and Fast Implementation of Masked AES\n        // Genelle, Prouff and Quisquater\n        // Section 3.2\n\n        debug_assert_eq!(inputs.len(), scratch.len());\n\n        // Keep an accumulator of all of the previous products\n        let mut acc = FieldElement::ONE;\n\n        // Pass through the input vector, recording the previous\n        // products in the scratch space\n        for (input, scratch) in inputs.iter().zip(scratch.iter_mut()) {\n            *scratch = acc;\n            // acc <- acc * input, but skipping zeros (constant-time)\n            #[cfg_attr(not(feature = \"zeroize\"), allow(unused_mut))]\n            let mut product = &acc * input;\n            acc.conditional_assign(&product, !input.is_zero());\n\n            #[cfg(feature = \"zeroize\")]\n            product.zeroize();\n        }\n\n        // acc is nonzero because we skipped zeros in inputs\n        assert!(bool::from(!acc.is_zero()));\n\n        // Compute the inverse of all products\n        acc = acc.invert();\n\n        // Pass through the vector backwards to compute the inverses\n        // in place\n        for (input, scratch) in inputs.iter_mut().rev().zip(scratch.iter_mut().rev()) {\n            #[cfg_attr(not(feature = \"zeroize\"), allow(unused_mut))]\n            let mut tmp = &acc * input;\n            #[cfg_attr(not(feature = \"zeroize\"), allow(unused_mut))]\n            let mut inverse = &acc * scratch;\n            // input <- acc * scratch, then acc <- tmp\n            // Again, we skip zeros in a constant-time way\n            let nz = !input.is_zero();\n            input.conditional_assign(&inverse, nz);\n            acc.conditional_assign(&tmp, nz);\n\n            #[cfg(feature = \"zeroize\")]\n            {\n                tmp.zeroize();\n                inverse.zeroize();\n            }\n        }\n\n        #[cfg(feature = \"zeroize\")]\n        {\n            acc.zeroize();\n            scratch.zeroize();\n        }\n    }","attr_info":{"attributes":[{"DocComment":" Given a slice of pub(crate)lic `FieldElements`, replace each with its inverse. `scratch` can"},{"DocComment":" contain anything, so long as its length is the same as `inputs`."},{"DocComment":""},{"DocComment":" When an input `FieldElement` is zero, its value is unchanged."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":" Panics when `scratch.len() != inputs.len()`"}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"HashConsedValue":[11915,{"Ref":[{"Var":{"Free":0}},{"HashConsedValue":[7036,{"Slice":{"Deduplicated":3140}}]},"Mut"]}]},{"HashConsedValue":[11916,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":7036},"Mut"]}]}],"output":{"Deduplicated":1801}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":53,"item_meta":{"name":[{"Ident":["curve25519",0]},{"Ident":["field",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":3140},"kind":"InherentImplBlock"}}},{"Ident":["invert",0]}],"span":{"data":{"file_id":8,"beg":{"line":280,"col":4},"end":{"line":289,"col":5}},"generated_from_span":null},"source_text":"pub(crate) fn invert(&self) -> FieldElement {\n        // The bits of p-2 = 2^255 -19 -2 are 11010111111...11.\n        //\n        //                                 nonzero bits of exponent\n        let (t19, t3) = self.pow22501();   // t19: 249..0 ; t3: 3,1,0\n        let t20 = t19.pow2k(5);            // 254..5\n        let t21 = &t20 * &t3;              // 254..5,3,1,0\n\n        t21\n    }","attr_info":{"attributes":[{"DocComment":" Given a nonzero field element, compute its inverse."},{"DocComment":""},{"DocComment":" The inverse is computed as self^(p-2), since"},{"DocComment":" x^(p-2)x = x^(p-1) = 1 (mod p)."},{"DocComment":""},{"DocComment":" This function returns zero on input zero."},{"Unknown":{"path":"rustfmt::skip","args":null}},{"Unknown":{"path":"allow","args":"clippy::let_and_return"}}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":11760}],"output":{"Deduplicated":3140}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":8,"beg":{"line":280,"col":4},"end":{"line":289,"col":5}},"generated_from_span":null},"bound_body_regions":13,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":8,"beg":{"line":280,"col":35},"end":{"line":280,"col":47}},"generated_from_span":null},"ty":{"Deduplicated":3140}},{"index":1,"name":"self","span":{"data":{"file_id":8,"beg":{"line":280,"col":25},"end":{"line":280,"col":30}},"generated_from_span":null},"ty":{"Deduplicated":6928}},{"index":2,"name":"t19","span":{"data":{"file_id":8,"beg":{"line":284,"col":13},"end":{"line":284,"col":16}},"generated_from_span":null},"ty":{"Deduplicated":3140}},{"index":3,"name":"t3","span":{"data":{"file_id":8,"beg":{"line":284,"col":18},"end":{"line":284,"col":20}},"generated_from_span":null},"ty":{"Deduplicated":3140}},{"index":4,"name":null,"span":{"data":{"file_id":8,"beg":{"line":284,"col":24},"end":{"line":284,"col":39}},"generated_from_span":null},"ty":{"Deduplicated":6996}},{"index":5,"name":null,"span":{"data":{"file_id":8,"beg":{"line":284,"col":24},"end":{"line":284,"col":28}},"generated_from_span":null},"ty":{"Deduplicated":6929}},{"index":6,"name":"t20","span":{"data":{"file_