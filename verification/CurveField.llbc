 operation takes **an arbitrary 256-bit random value** and"},{"DocComment":" clears the most-significant bit (making it a 255-bit number), sets the next bit, and then"},{"DocComment":" clears the 3 least-significant bits. In other words, it directly creates a scalar value that is"},{"DocComment":" in the right form and pre-multiplied by the cofactor."},{"DocComment":""},{"DocComment":" See [here](https://neilmadden.blog/2020/05/28/whats-the-curve25519-clamping-all-about/) for"},{"DocComment":" more details."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":2743}],"output":{"Deduplicated":2743}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":5,"beg":{"line":1610,"col":0},"end":{"line":1615,"col":1}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":5,"beg":{"line":1610,"col":51},"end":{"line":1610,"col":59}},"generated_from_span":null},"ty":{"Deduplicated":2743}},{"index":1,"name":"bytes","span":{"data":{"file_id":5,"beg":{"line":1610,"col":27},"end":{"line":1610,"col":36}},"generated_from_span":null},"ty":{"Deduplicated":2743}},{"index":2,"name":null,"span":{"data":{"file_id":5,"beg":{"line":1611,"col":10},"end":{"line":1611,"col":11}},"generated_from_span":null},"ty":{"Deduplicated":1784}},{"index":3,"name":null,"span":{"data":{"file_id":5,"beg":{"line":1612,"col":10},"end":{"line":1612,"col":12}},"generated_from_span":null},"ty":{"Deduplicated":1784}},{"index":4,"name":null,"span":{"data":{"file_id":5,"beg":{"line":1613,"col":10},"end":{"line":1613,"col":12}},"generated_from_span":null},"ty":{"Deduplicated":1784}},{"index":5,"name":null,"span":{"data":{"file_id":0,"beg":{"