           t |= (self.bytes[8 * k + bi] as u64) << (8 * bi);\n                bi += 1;\n            }\n            x_u64[k] = t;\n            k += 1;\n        }\n\n        let width = 1 << w;\n        let window_mask = width - 1;\n\n        let mut pos = 0;\n        let mut carry = 0;\n        while pos < 256 {\n            // Construct a buffer of bits of the scalar, starting at bit `pos`\n            let u64_idx = pos / 64;\n            let bit_idx = pos % 64;\n            let bit_buf: u64 = if bit_idx < 64 - w {\n                // This window's bits are contained in a single u64\n                x_u64[u64_idx] >> bit_idx\n            } else {\n                // Combine the current u64's bits with the bits from the next u64\n                (x_u64[u64_idx] >> bit_idx) | (x_u64[1 + u64_idx] << (64 - bit_idx))\n            };\n\n            // Add the carry into the current window\n            let window = carry + (bit_buf & window_mask);\n\n            if window & 1 == 0 {\n                // If the window value is even, preserve the carry and continue.\n                // Why is the carry preserved?\n                // If carry == 0 and window & 1 == 0, then the next carry should be 0\n                // If carry == 1 and window & 1 == 0, then bit_buf & 1 == 1 so the next carry should be 1\n                pos += 1;\n                continue;\n            }\n\n            if window < width / 2 {\n                carry = 0;\n                naf[pos] = window as i8;\n            } else {\n                carry = 1;\n                naf[pos] = (window as i8).wrapping_sub(width as i8);\n            }\n\n            pos += w;\n        }\n\n        naf\n    }","attr_info":{"attributes":[{"DocComment":" Compute a width-\\\\(w\\\\) \"Non-Adjacent Form\" of this scalar."},{"DocComment":""},{"DocComment":" A width-\\\\(w\\\\) NAF of a positive integer \\\\(k\\\\) is an expression"},{"DocComment":" $$"},{"DocComment":" k = \\sum_{i=0}\\^m n\\_i 2\\^i,"},{"DocComment":" $$"},{"DocComment":" where each nonzero"},{"DocComment":" coefficient \\\\(n\\_i\\\\) is odd and bounded by \\\\(|n\\_i| < 2\\^{w-1}\\\\),"},{"DocComment":" \\\\(n\\_{m-1}\\\\) is nonzero, and at most one of any \\\\(w\\\\) consecutive"},{"DocComment":" coefficients is nonzero.  (Hankerson, Menezes, Vanstone; def 3.32)."},{"DocComment":""},{"DocComment":" The length of the NAF is at most one more than the length of"},{"DocComment":" the binary representation of \\\\(k\\\\).  This is why the"},{"DocComment":" `Scalar` type maintains an invariant (invariant #1) that the top bit is"},{"DocComment":" \\\\(0\\\\), so that the NAF of a scalar has at most 256 digits."},{"DocComment":""},{"DocComment":" Intuitively, this is like a binary expansion, except that we"},{"DocComment":" allow some coefficients to grow in magnitude up to"},{"DocComment":" \\\\(2\\^{w-1}\\\\) so that the nonzero coefficients are as sparse"},{"DocComment":" as possible."},{"DocComment":""},{"DocComment":" When doing scalar multiplication, we can then use a lookup"},{"DocComment":" table of precomputed multiples of a point to add the nonzero"},{"DocComment":" terms \\\\( k_i P \\\\).  Using signed digits cuts the table size"},{"DocComment":" in half, and using odd digits cuts the table size in half"},{"DocComment":" again."},{"DocComment":""},{"DocComment":" To compute a \\\\(w\\\\)-NAF, we use a modification of Algorithm 3.35 of HMV:"},{"DocComment":""},{"DocComment":" 1. \\\\( i \\gets 0 \\\\)"},{"DocComment":" 2. While \\\\( k \\ge 1 \\\\):"},{"DocComment":"     1. If \\\\(k\\\\) is odd, \\\\( n_i \\gets k \\operatorname{mods} 2^w \\\\), \\\\( k \\gets k - n_i \\\\)."},{"DocComment":"     2. If \\\\(k\\\\) is even, \\\\( n_i \\gets 0 \\\\)."},{"DocComment":"     3. \\\\( k \\gets k / 2 \\\\), \\\\( i \\gets i + 1 \\\\)."},{"DocComment":" 3. Return \\\\( n_0, n_1, ... , \\\\)"},{"DocComment":""},{"DocComment":" Here \\\\( \\bar x = x \\operatorname{mods} 2^w \\\\) means the"},{"DocComment":" \\\\( \\bar x \\\\) with \\\\( \\bar x \\equiv x \\pmod{2^w} \\\\) and"},{"DocComment":" \\\\( -2^{w-1} \\leq \\bar x < 2^{w-1} \\\\)."},{"DocComment":""},{"DocComment":" We implement this by scanning across the bits of \\\\(k\\\\) from"},{"DocComment":" least-significant bit to most-significant-bit."},{"DocComment":" Write the bits of \\\\(k\\\\) as"},{"DocComment":" $$"},{"DocComment":" k = \\sum\\_{i=0}\\^m k\\_i 2^i,"},{"DocComment":" $$"},{"DocComment":" and split the sum as"},{"DocComment":" $$"},{"DocComment":" k = \\sum\\_{i=0}^{w-1} k\\_i 2^i + 2^w \\sum\\_{i=0} k\\_{i+w} 2^i"},{"DocComment":" $$"},{"DocComment":" where the first part is \\\\( k \\mod 2^w \\\\)."},{"DocComment":""},{"DocComment":" If \\\\( k \\mod 2^w\\\\) is odd, and \\\\( k \\mod 2^w < 2^{w-1} \\\\), then we emit"},{"DocComment":" \\\\( n_0 = k \\mod 2^w \\\\).  Instead of computing"},{"DocComment":" \\\\( k - n_0 \\\\), we just advance \\\\(w\\\\) bits and reindex."},{"DocComment":""},{"DocComment":" If \\\\( k \\mod 2^w\\\\) is odd, and \\\\( k \\mod 2^w \\ge 2^{w-1} \\\\), then"},{"DocComment":" \\\\( n_0 = k \\operatorname{mods} 2^w = k \\mod 2^w - 2^w \\\\)."},{"DocComment":" The quantity \\\\( k - n_0 \\\\) is"},{"DocComment":" $$"},{"DocComment":" \\begin{aligned}"},{"DocComment":" k - n_0 &= \\sum\\_{i=0}^{w-1} k\\_i 2^i + 2^w \\sum\\_{i=0} k\\_{i+w} 2^i"},{"DocComment":"          - \\sum\\_{i=0}^{w-1} k\\_i 2^i + 2^w \\\\\\\\"},{"DocComment":" &= 2^w + 2^w \\sum\\_{i=0} k\\_{i+w} 2^i"},{"DocComment":" \\end{aligned}"},{"DocComment":" $$"},{"DocComment":" so instead of computing the subtraction, we can set a carry"},{"DocComment":" bit, advance \\\\(w\\\\) bits, and reindex."},{"DocComment":""},{"DocComment":" If \\\\( k \\mod 2^w\\\\) is even, we emit \\\\(0\\\\), advance 1 bit"},{"DocComment":" and reindex.  In fact, by setting all digits to \\\\(0\\\\)"},{"DocComment":" initially, we don't need to emit anything."}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"T