double negative is a positive."},{"DocComment":" assert_eq!(-Sign::Negative, Sign::Positive);"},{"DocComment":" // Zero is its own negation."},{"DocComment":" assert_eq!(-Sign::Zero, Sign::Zero);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"neg"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Self_Output"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"neg","attr_info":{"attributes":[{"DocComment":" Performs the unary `-` operation."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x: i32 = 12;"},{"DocComment":" assert_eq!(-x, -12);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":10511}],"output":{"Deduplicated":10512}},"item":{"id":154,"generics":{"regions":[],"types":[{"Deduplicated":10511},{"Deduplicated":10512}],"const_generics":[],"trait_refs":[{"HashConsedValue":[10585,{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":10511},{"Deduplicated":10512}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[15,0]}}],"vtable":{"id":{"Adt":28},"generics":{"regions":[],"types":[{"Deduplicated":10512}],"const_generics":[],"trait_refs":[]}}},{"def_id":16,"item_meta":{"name":[{"Ident":["subtle",0]},{"Ident":["ConditionallySelectable",0]}],"span":{"data":{"file_id":11,"beg":{"line":393,"col":0},"end":{"line":393,"col":39}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A type which can be conditionally selected in constant time."},{"DocComment":""},{"DocComment":" This trait also provides generic implementations of conditional"},{"DocComment":" assignment and conditional swaps."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"data":{"file_id":11,"beg":{"line":393,"col":35},"end":{"line":393,"col":39}},"generated_from_span":null},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":10511}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"conditional_select","attr_info":{"attributes":[{"DocComment":" Select `a` or `b` according to `choice`."},{"DocComment":""},{"DocComment":" # Returns"},{"DocComment":""},{"DocComment":" * `a` if `choice == Choice(0)`;"},{"DocComment":" * `b` if `choice == Choice(1)`."},{"DocComment":""},{"DocComment":" This function should execute in constant time."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use subtle::ConditionallySelectable;"},{"DocComment":" #"},{"DocComment":" # fn main() {"},{"DocComment":" let x: u8 = 13;"},{"DocComment":" let y: u8 = 42;"},{"DocComment":""},{"DocComment":" let z = u8::conditional_select(&x, &y, 0.into());"},{"DocComment":" assert_eq!(z, x);"},{"DocComment":" let z = u8::conditional_select(&x, &y, 1.into());"},{"DocComment":" assert_eq!(z, y);"},{"DocComment":" # }"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"signature":{"is_uns