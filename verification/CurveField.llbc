compute sqrt(u/v) = sqrt(u)/sqrt(v)","by first computing","   r = u^((p+3)/8) v^(p-1-(p+3)/8)","     = u u^((p-5)/8) v^3 (v^7)^((p-5)/8)","     = (uv^3) (uv^7)^((p-5)/8).","","If v is nonzero and u/v is square, then r^2 = ±u/v,","                                    so vr^2 = ±u.","If vr^2 =  u, then sqrt(u/v) = r.","If vr^2 = -u, then sqrt(u/v) = r*sqrt(-1).","","If v is zero, r is also zero."]],[363,["Choose the nonnegative square root.","","NOTE: written as negate-then-conditional-assign rather than","`r.conditional_negate(r_is_negative)`: semantically identical and","still constant-time, but it avoids subtle's `ConditionallyNegatable`","blanket impl (whose `for<'a> &'a T: Neg` bound breaks the Aeneas","verification toolchain; see verification/field/README.md)."]]]}}},{"def_id":16,"item_meta":{"name":[{"Ident":["curve25519",0]},{"Ident":["field",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1391},"kind":"InherentImplBlock"}}},{"Ident":["invsqrt",0]}],"span":{"data":{"file_id":1,"beg":{"line":384,"col":4},"end":{"line":386,"col":5}},"generated_from_span":null},"source_text":"pub(crate) fn invsqrt(&self) -> (Choice, FieldElement) {\n        FieldElement::sqrt_ratio_i(&FieldElement::ONE, self)\n    }","attr_info":{"attributes":[{"DocComment":" Attempt to compute `sqrt(1/self)` in constant time."},{"DocComment":""},{"DocComment":" Convenience wrapper around `sqrt_ratio_i`."},{"DocComment":""},{"DocComment":" This function always returns the nonnegative square root."},{"DocComment":""},{"DocComment":" # Return"},{"DocComment":""},{"DocComment":" - `(Choice(1), +sqrt(1/self))  ` if `self` is a nonzero square;"},{"DocComment":" - `(Choice(0), zero)           ` if `self` is zero;"},{"DocComment":" - `(Choice(0), +sqrt(i/self))  ` if `self` is a nonzero nonsquare;"},{"DocComment":""}],"inline":null,"rename":null,"public":false},"i