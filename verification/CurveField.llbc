cComment":" `FromResidual::from_residual(r).branch() --> ControlFlow::Break(r)`."},{"DocComment":" (The residual is not mandated to be *identical* when interconversion is involved.)"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(try_trait_v2)]"},{"DocComment":" use std::ops::{ControlFlow, FromResidual};"},{"DocComment":""},{"DocComment":" assert_eq!(Result::<String, i64>::from_residual(Err(3_u8)), Err(3));"},{"DocComment":" assert_eq!(Option::<String>::from_residual(None), None);"},{"DocComment":" assert_eq!("},{"DocComment":"     ControlFlow::<_, String>::from_residual(ControlFlow::Break(5)),"},{"DocComment":"     ControlFlow::Break(5),"},{"DocComment":" );"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"from_residual"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"R"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":49,"generics":{"regions":[],"types":[{"Deduplicated":10511},{"Deduplicated":10512}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":10512}],"output":{"Deduplicated":10511}},"src":{"TraitDecl":{"trait_ref":{"id":49,"generics":{"regions":[],"types":[{"Deduplicated":10511},{"Deduplicated":10512}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":0},"has_default":false}},"is_global_initializer":null,"body":"Opaque"},{"def_id":405,"item_meta":{"name":[{"Ident":["curve25519",0]},{"Ident":["scalar",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":2689},"kind":"InherentImplBlock"}}},{"Ident":["non_adjacent_form",0]}],"span":{"data":{"file_id":28,"beg":{"line":1028,"col":4},"end":{"line":1093,"col":5}},"generated_from_span":null},"source_text":"pub(crate) fn non_adjacent_form(&self, w: usize) -> [i8; 256] {\n        // required by the NAF definition\n        debug_assert!(w >= 2);\n        // required so that the NAF digits fit in i8\n        debug_assert!(w <= 8);\n\n        let mut naf = [0i8; 256];\n\n        let mut x_u64 = [0u64; 5];\n        // AENEAS-COMPAT: index-based little-endian load instead of\n        // read_le_u64_into (its chunks/zip iterators are opaque to the\n        // extraction). Pure refactor, semantics identical.\n        let mut k: usize = 0;\n        while k < 4 {\n            let mut t: u64 = 0;\n            let mut bi: usize = 0;\n            while bi < 8 {\n                t |= (self.bytes[8 * k + bi] as u64) << (8 * bi);\n                bi += 1;\n            }\n            x_u64[k] = t;\n            k += 1;\n        }\n\n        let width = 1 << w;\n        let window_mask = width - 1;\n\n        let mut pos = 0;\n        let mut carry = 0;\n        while pos < 256 {\n            // Construct a buffer of bits of the scalar, starting at bit `pos`\n            let u64_idx = pos / 64;\n            let bit_idx = pos % 64;\n            let bit_buf: u64 = if bit_idx < 64 - w {\n                // This window's bits are contained in a single u64\n                x_u64[u64_idx] >> bit_idx\n            } else {\n                // Combine the current u64's bits with the bits from the next u64\n                (x_u64[u64_idx] >> bit_idx) | (x_u64[1 + u64_idx] << (64 - bit_idx))\n            };\n\n            // Add the carry into the current window\n            let window = carry + (bit_buf & window_mask);\n\n            if window & 1 == 0 {\n                // If the window value is even, preserve the carry and continue.\n                // Why is the carry preserved?\n                // If carry == 0 and window & 1 == 0, then the next carry should be 0\n                // If carry == 1 and window & 1 == 0, then bit_buf & 1 == 1 so the next carry should be 1\n                pos += 1;\n                continue;\n            }\n\n            if window < width / 2 {\n                carry = 0;\n                naf[pos] = window as i8;\n            } else {\n                carry = 1;\n                naf[pos] = (window as i8).wrapping_sub(width as i8);\n            }\n\n            pos += w;\n        }\n\n        naf\n    }","attr_info":{"attributes":[{"DocComment":" Compute a width-\\\\(w\\\\) \"Non-Adjacent Form\" of this scalar."},{"DocComment":""},{"DocComment":" A width-\\\\(w\\\\) NAF of a positive integer \\\\(k\\\\) is an expression"},{"DocComment":" $$"},{"DocComment":" k = \\sum_{i=0}\\^m n\\_i 2\\^i,"},{"DocComment":" $$"},{"DocComment":" where each nonzero"},{"DocComment":" coefficient \\\\(n\\_i\\\\) is odd and bounded by \\\\(|n\\_i| < 2\\^{w-1}\\\\),"},{"DocComment":" \\\\(n\\_{m-1}\\\\) is nonzero, and at most one of any \\\\(w\\\\) consecutive"},{"DocComment":" coefficients is nonzero.  (Hankerson, Menezes, Vanstone; def 3.32)."},{"DocComment":""},{"DocComment":" The length of the NAF is at most one more than the length of"},{"DocComment":" the binary representation of \\\\(k\\\\).  This is why the"},{"DocComment":" `Scalar` type maintains an invariant (invariant #1) that the top bit is"},{"DocComment":" \\\\(0\\\\), so that the NAF of a scalar has at most 256 digits."},{"DocComment":""},{"DocComment":" Intuitively, this is like a binary expansion, except that we"},{"DocComment":" allow some coefficients to grow in magnitude up to"},{"DocComment":" \\\\(2\\^{w-1}\\\\) so that the nonzero coefficients are as sparse"},{"DocComment":" as possible."},{"DocComment":""},{"DocComment":" When doing scalar multiplication, we can then use a lookup"},{"DocComment":" table of precomputed multiples of a point to add the nonzero"},{"DocComment":" terms \\\\( k_i P \\\\).  Using signed digits cuts the table size"},{"DocComment":" in half, and using odd digits cuts the table size in half"},{"DocComment":" again."},{"DocComment":""},{"DocComment":" To compute a \\\\(w\\\\)-NAF, we use a modification of Algorithm 3.35 of HMV:"},{"DocComment":""},{"DocComment":" 1. \\\\( i \\gets 0 \\\\)"},{"DocComment":" 2. While \\\\( k \\ge 1 \\\\):"},{"DocComment":"     1. If \\\\(k\\\\) is odd, \\\\( n_i \\gets k \\operatorname{mods} 2^w \\\\), \\\\( k \\gets k - n_i \\\\)."},{"DocComment":"     2. If \\\\(k\\\\) is even, \\\\( n_i \\gets 0 \\\\)."},{"DocComment":"     3. \\\\( k \\gets k / 2 \\\\), \\\\( i \\gets i + 1 \\\\)."},{"DocComment":" 3. Return \\\\( n_0, n_1, ... , \\\\)"},{"DocComment":""},{"DocComment":" Here \\\\( \\bar x = x \\operatorname{mods} 2^w \\\\) means the"},{"DocComment":" \\\\( \\bar x \\\\) with \\\\( \\bar x \\equiv x \\pmod{2^w} \\\\) and"},{"DocComment":" \\\\( -2^{w-1} \\leq \\bar x < 2^{w-1} \\\\)."},{"DocComment":""},{"DocComment":" We implement this by scanning across the bits of \\\\(k\\\\) from"},{"DocComment":" least-significant bit to most-significant-bit."},{"DocComment":" Write the bits of \\\\(k\\\\) as"},{"DocComment":" $$"},{"DocComment":" k = \\sum\\_{i=0}\\^m k\\_i 2^i,"},{"DocComment":" $$"},{"DocComment":" and split the sum as"},{"DocComment":" $$"},{"DocComment":" k = \\sum\\_{i=0}^{w-1} k\\_i 2^i + 2^w \\sum\\_{i=0} k\\_{i+w} 2^i"},{"DocComment":" $$"},{"DocComment":" where the first part is \\\\( k \\mod 2^w \\\\)."},{"DocComment":""},{"DocComment":" If \\\\( k \\mod 2^w\\\\) is odd, and \\\\( k \\mod 2^w < 2^{w-1} \\\\), then we emit"},{"DocComment":" \\\\( n_0 = k \\mod 2^w \\\\).  Instead of computing"},{"DocComment":" \\\\( k - n_0 \\\\), we just advance \\\\(w\\\\) bits and reindex."},{"DocComment":""},{"DocComment":" If \\\\( k \\mod 2^w\\\\) is odd, and \\\\( k \\mod 2^w \\ge 2^{w-1} \\\\), then"},{"DocComment":" \\\\( n_0 = k \\operatorname{mods} 2^w = k \\mod 2^w - 2^w \\\\)."},{"DocComment":" The quantity \\\\( k - n_0 \\\\) is"},{"DocComment":" $$"},{"DocComment":" \\begin{aligned}"},{"DocComment":" k - n_0 &= \\sum\\_{i=0}^{w-1} k\\_i 2^i + 2^w \\sum\\_{i=0} k\\_{i+w} 2^i"},{"DocComment":"          - \\sum\\_{i=0}^{w-1} k\\_i 2^i + 2^w \\\\\\\\"},{"DocComment":" &= 2^w + 2^w \\sum\\_{i=0} k\\_{i+w} 2^i"},{"DocComment":" \\end{aligned}"},{"DocComment":" $$"},{"DocComment":" so instead of computing the subtraction, we can set a carry"},{"DocComment":" bit, advance \\\\(w\\\\) bits, and reindex."},{"DocComment":""},{"DocComment":" If \\\\( k \\mod 2^w\\\\) is even, we emit \\\\(0\\\\), advance 1 bit"},{"DocComment":" and reindex.  In fact, by setting all digits to \\\\(0\\\\)"},{"DocComment":" initially, we don't need to emit anything."}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":10537},{"Deduplicated":1551}],"output":{"Deduplicated":8128}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":28,"beg":{"line":1028,"col":4},"end":{"line":1093,"col":5}},"generated_from_span":null},"bound_body_regions":2,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":28,"beg":{"line":1028,"col":56},"end":{"line":1028,"col":65}},"generated_from_span":null},"ty":{"Deduplicated":8128}},{"index":1,"name":"self","span":{"data":{"file_id":28,"beg":{"line":1028,"col":36},"end":{"line":1028,"col":41}},"generated_from_span":null},"ty":{"Deduplicated":6598}},{"index":2,"name":"w","span":{"data":{"file_id":28,"beg":{"line":1028,"col":43},"end":{"line":1028,"col":44}},"generated_from_span":null},"ty":{"Deduplicated":1551}},{"index":3,"name":null,"span":{"data